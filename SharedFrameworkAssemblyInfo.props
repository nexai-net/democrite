<Project>

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>12</LangVersion>

		<!-- Democrite framework version (assemblies and nuget packages) -->
		<Version>1.0.0</Version>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<InformationalVersion>1.0.0</InformationalVersion>

		<Authors>Nexai</Authors>
		<Company>Nexai.net</Company>

		<NeutralLanguage>en</NeutralLanguage>
		<Copyright>Copyright (c) Nexai.net</Copyright>
		
		<PackageProjectUrl>https://github.com/nexai-net/democrite</PackageProjectUrl>
		<PackageLicenseFile>pkg/LICENSE</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>pkg/logo.png</PackageIcon>
		<RepositoryType>Git</RepositoryType>
		<RepositoryUrl>https://github.com/nexai-net/democrite/</RepositoryUrl>

	</PropertyGroup>

	<ItemGroup>
      <None Include="$(MSBuildThisFileDirectory)docs\logo.png" Pack="true" PackagePath="pkg/"/>
      <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="pkg/" />
      <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
	
</Project>