<Project Sdk="Microsoft.NET.Sdk">

	<!--TO-DO from Opus 5.5 Test projects require a solution build : Eight test csproj files (Builders, Cluster, Core, Node.Abstraction, Node.Signals, Node, Test.Interfaces, Test.VGrains) use $(SolutionDir) in Import and ProjectReference paths. 'dotnet build' or 'dotnet test' on a single project therefore resolves '\SharedFrameworkAssmblyInfo.props' and fails. Use relative paths or $(MSBuildThisFileDirectory), or centralize them in a Directory.Build.props.-->
	<Import Project="$(SolutionDir)\SharedFrameworkAssmblyInfo.props" />

	<PropertyGroup>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.Common" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="Moq" />
		<PackageReference Include="NFluent" />
		<PackageReference Include="NSubstitute" />
		<PackageReference Include="xunit" />
		<PackageReference Include="xunit.runner.visualstudio">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="coverlet.collector">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="$(SolutionDir)\src\Frameworks\Democrite.Framework.Core.Abstractions\Democrite.Framework.Core.Abstractions.csproj" />
	  <ProjectReference Include="$(SolutionDir)\src\Frameworks\Democrite.Framework.Core\Democrite.Framework.Core.csproj" />
	  <ProjectReference Include="..\Democrite.UnitTests.ToolKit\Democrite.UnitTests.ToolKit.csproj" />
	</ItemGroup>

</Project>
